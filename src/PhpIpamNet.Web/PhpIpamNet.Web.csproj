<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>PhpIpamNet.Web</RootNamespace>
    <UserSecretsId>phpipam-net-dev</UserSecretsId>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\PhpIpamNet.Domain\PhpIpamNet.Domain.csproj" />
    <ProjectReference Include="..\PhpIpamNet.Infrastructure\PhpIpamNet.Infrastructure.csproj" />
    <ProjectReference Include="..\PhpIpamNet.Migrations.SqlServer\PhpIpamNet.Migrations.SqlServer.csproj" />
    <ProjectReference Include="..\PhpIpamNet.Migrations.Sqlite\PhpIpamNet.Migrations.Sqlite.csproj" />
  </ItemGroup>
</Project>
