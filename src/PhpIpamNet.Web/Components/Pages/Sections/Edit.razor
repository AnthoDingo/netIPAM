@page "/sections/new"
@page "/sections/{Id:int}/edit"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inject SectionService Sections
@inject NavigationManager Nav

<PageTitle>@(_isNew ? "New section" : $"Edit {_section?.Name}")</PageTitle>

<h1 class="h3 mb-4"><i class="bi bi-folder me-2"></i>@(_isNew ? "New section" : "Edit section")</h1>

<div class="phpipam-card" style="max-width: 720px;">
    <div class="phpipam-card-body">
        @if (_section is not null)
        {
            <EditForm Model="_section" OnValidSubmit="Save">
                <div class="mb-3">
                    <label class="form-label">Name *</label>
                    <InputText class="form-control" @bind-Value="_section.Name" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Description</label>
                    <InputTextArea class="form-control" rows="3" @bind-Value="_section.Description" />
                </div>
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Subnet ordering</label>
                        <InputSelect class="form-select" @bind-Value="_section.SubnetOrdering">
                            <option value="">(default)</option>
                            <option value="subnet,asc">subnet,asc</option>
                            <option value="subnet,desc">subnet,desc</option>
                            <option value="description,asc">description,asc</option>
                        </InputSelect>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Display order</label>
                        <InputNumber class="form-control" @bind-Value="_section.Order" />
                    </div>
                </div>
                <div class="form-check mb-3">
                    <InputCheckbox class="form-check-input" id="strict" @bind-Value="_section.StrictMode" />
                    <label class="form-check-label" for="strict">Strict mode (no overlapping subnets)</label>
                </div>
                <div class="form-check mb-3">
                    <InputCheckbox class="form-check-input" id="showVlan" @bind-Value="_section.ShowVlan" />
                    <label class="form-check-label" for="showVlan">Show VLAN column</label>
                </div>
                <div class="form-check mb-3">
                    <InputCheckbox class="form-check-input" id="showVrf" @bind-Value="_section.ShowVrf" />
                    <label class="form-check-label" for="showVrf">Show VRF column</label>
                </div>

                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-check-lg"></i> Save
                </button>
                <a class="btn btn-link" href="/sections">Cancel</a>
            </EditForm>
        }
    </div>
</div>

@code {
    [Parameter] public int? Id { get; set; }
    private Section? _section;
    private bool _isNew => Id is null;

    protected override async Task OnParametersSetAsync()
    {
        _section = Id is null ? new Section() : await Sections.GetAsync(Id.Value);
        if (_section is null) Nav.NavigateTo("/sections");
    }

    private async Task Save()
    {
        if (_section is null) return;
        if (_isNew) await Sections.CreateAsync(_section);
        else await Sections.UpdateAsync(_section);
        Nav.NavigateTo("/sections");
    }
}
