@page "/admin/users/{Id:int}/password"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Policy = "Admin")]
@inject UserService Users
@inject NavigationManager Nav

<PageTitle>Reset password</PageTitle>

<AdminPageHeader Title="Reset password" Icon="bi bi-key"
                 BackHref="/admin/users" BackLabel="Users" />

<div class="phpipam-card" style="max-width: 540px;">
    <div class="phpipam-card-body">
        @if (_user is not null)
        {
            <p>Reset password for <strong>@_user.Username</strong>.</p>
            <EditForm Model="_form" OnValidSubmit="Save" FormName="resetPwd">
                <div class="mb-3">
                    <label class="form-label">New password *</label>
                    <input type="password" class="form-control" @bind="_form.Password" />
                </div>
                @if (!string.IsNullOrEmpty(_error))
                {
                    <div class="alert alert-danger py-2">@_error</div>
                }
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-check-lg"></i> Reset
                </button>
                <a class="btn btn-link" href="/admin/users">Cancel</a>
            </EditForm>
        }
    </div>
</div>

@code {
    [Parameter] public int Id { get; set; }
    [SupplyParameterFromForm] private FormModel _form { get; set; } = new();
    private User? _user;
    private string? _error;

    protected override async Task OnParametersSetAsync()
    {
        _user = await Users.FindByIdAsync(Id);
        if (_user is null) Nav.NavigateTo("/admin/users");
    }

    private async Task Save()
    {
        if (string.IsNullOrWhiteSpace(_form.Password))
        {
            _error = "Password required.";
            return;
        }
        await Users.ResetPasswordAsync(Id, _form.Password);
        Nav.NavigateTo("/admin/users");
    }

    public class FormModel { public string Password { get; set; } = string.Empty; }
}
