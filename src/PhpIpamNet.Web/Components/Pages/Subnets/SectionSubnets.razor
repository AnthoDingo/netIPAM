@page "/sections/{SectionId:int}/subnets"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inject SectionService Sections
@inject SubnetService Subnets

<PageTitle>Subnets — @_section?.Name</PageTitle>

@if (_section is null)
{
    <p class="text-muted">Loading…</p>
}
else
{
    <div class="d-flex align-items-center justify-content-between mb-3">
        <h1 class="h3 mb-0">
            <a href="/sections" class="text-decoration-none text-muted small">
                <i class="bi bi-arrow-left"></i> Sections
            </a>
            <i class="bi bi-folder-fill ms-2 me-2"></i>@_section.Name
        </h1>
        <a class="btn btn-primary btn-sm" href="@($"/sections/{SectionId}/subnets/new")">
            <i class="bi bi-plus-lg"></i> New subnet
        </a>
    </div>

    @if (_subnets is null || _subnets.Count == 0)
    {
        <div class="phpipam-card">
            <div class="phpipam-card-body text-center text-muted py-5">
                <i class="bi bi-diagram-3 d-block mb-2" style="font-size: 2rem;"></i>
                No subnets in this section yet.
            </div>
        </div>
    }
    else
    {
        <div class="phpipam-card">
            <table class="phpipam-table">
                <thead>
                    <tr>
                        <th>Subnet</th>
                        <th>Description</th>
                        <th>Usage</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var s in _subnets)
                    {
                        var cidr = FormatCidr(s);
                        var u = _usage.GetValueOrDefault(s.Id);
                        <tr>
                            <td>
                                @if (s.IsFolder)
                                {
                                    <i class="bi bi-folder-fill me-1 text-warning"></i>
                                    <span>@s.Description</span>
                                }
                                else
                                {
                                    <a href="@($"/subnets/{s.Id}")" class="text-decoration-none">
                                        <i class="bi bi-diagram-3 me-1"></i>@cidr
                                    </a>
                                }
                            </td>
                            <td class="text-muted">@s.Description</td>
                            <td style="width: 220px;">
                                @if (!s.IsFolder && u.total > 0)
                                {
                                    var pct = u.percentUsed;
                                    var cls = pct >= 90 ? "crit" : pct >= 70 ? "warn" : "";
                                    <div class="phpipam-usage">
                                        <div class="phpipam-usage-fill @cls" style="width: @($"{pct:0.#}")%"></div>
                                        <div class="phpipam-usage-label">@u.used / @u.total</div>
                                    </div>
                                }
                            </td>
                            <td class="text-end">
                                <a class="btn btn-sm btn-outline-secondary" href="@($"/subnets/{s.Id}/edit")">
                                    <i class="bi bi-pencil"></i>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
}

@code {
    [Parameter] public int SectionId { get; set; }
    private Section? _section;
    private List<Subnet>? _subnets;
    private Dictionary<int, (long total, long used, double percentUsed)> _usage = new();

    protected override async Task OnParametersSetAsync()
    {
        _section = await Sections.GetAsync(SectionId);
        if (_section is null) return;
        _subnets = await Subnets.ForSectionAsync(SectionId);
        _usage.Clear();
        foreach (var s in _subnets)
        {
            if (s.IsFolder) continue;
            _usage[s.Id] = await Subnets.UsageAsync(s.Id);
        }
    }

    private static string FormatCidr(Subnet s)
    {
        if (string.IsNullOrEmpty(s.SubnetAddress) || string.IsNullOrEmpty(s.Mask)) return "";
        try
        {
            var v = IpConverter.GuessVersion(s.SubnetAddress);
            return $"{IpConverter.ToPresentation(s.SubnetAddress, v)}/{s.Mask}";
        }
        catch
        {
            return $"{s.SubnetAddress}/{s.Mask}";
        }
    }
}
