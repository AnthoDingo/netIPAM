@* Sidebar gauche avec arbre de subnets + VLANs de la section courante *@
@inject SubnetService SubnetSvc
@inject VlanService VlanSvc
@inject NavigationManager Nav

@if (_loading)
{
    <div class="pi-sidebar-loading">
        <div class="spinner-border spinner-border-sm text-secondary" role="status"></div>
    </div>
}
else
{
    @* ── Arbre des subnets ── *@
    <div class="pi-sidebar-section-head">
        <i class="bi bi-diagram-3 me-1"></i>Subnets
        <a class="pi-sidebar-add" href="@($"/sections/{SectionId}/subnets/new")"
           title="Nouveau subnet">
            <i class="bi bi-plus-lg"></i>
        </a>
    </div>

    @if (_flatTree.Count == 0)
    {
        <div class="pi-sidebar-empty">Aucun subnet</div>
    }
    else
    {
        <div class="pi-subnet-tree">
            @foreach (var (subnet, depth) in _flatTree)
            {
                var cidr   = FormatCidr(subnet);
                var isActive = subnet.Id == ActiveSubnetId;
                var indent = depth * 14;

                <a class="pi-tree-node @(isActive ? "active" : "")"
                   href="@(subnet.IsFolder ? "#" : $"/subnets/{subnet.Id}")"
                   style="padding-left: @(12 + indent)px"
                   title="@(!subnet.IsFolder ? cidr : subnet.Description)">
                    @if (subnet.IsFolder)
                    {
                        <i class="bi bi-folder-fill pi-tree-icon folder"></i>
                        <span class="pi-tree-label">@(subnet.Description ?? "Folder")</span>
                    }
                    else
                    {
                        <i class="bi bi-chevron-right pi-tree-icon"></i>
                        <span class="pi-tree-label">@cidr</span>
                        @if (!string.IsNullOrEmpty(subnet.Description))
                        {
                            <span class="pi-tree-desc">@subnet.Description</span>
                        }
                    }
                </a>
            }
        </div>
    }

    @* ── VLANs de la section ── *@
    @if (_vlans.Count > 0)
    {
        <div class="pi-sidebar-section-head mt-1">
            <i class="bi bi-tag me-1"></i>VLANs
        </div>
        <div class="pi-vlan-list">
            @foreach (var v in _vlans)
            {
                <a class="pi-tree-node" href="@($"/admin/vlans/{v.VlanId}/edit")">
                    <i class="bi bi-tag pi-tree-icon vlan"></i>
                    <span class="pi-tree-label">@v.Name</span>
                    <span class="pi-vlan-num">@v.Number</span>
                </a>
            }
        </div>
    }
}

@code {
    [Parameter] public int  SectionId      { get; set; }
    [Parameter] public int? ActiveSubnetId { get; set; }

    private List<(Subnet subnet, int depth)> _flatTree = [];
    private List<Vlan> _vlans   = [];
    private bool _loading = true;

    // ── Arbre récursif aplati ────────────────────────────────────────
    record Node(Subnet Subnet, List<Node> Children, int Depth);

    private static List<Node> BuildTree(List<Subnet> all, int parentId, int depth)
        => all.Where(s => s.MasterSubnetId == parentId)
              .OrderBy(s => s.IsFolder ? 0 : 1)
              .ThenBy(s => s.SubnetAddress)
              .Select(s => new Node(s, BuildTree(all, s.Id, depth + 1), depth))
              .ToList();

    private static void Flatten(List<Node> nodes, List<(Subnet, int)> result)
    {
        foreach (var n in nodes)
        {
            result.Add((n.Subnet, n.Depth));
            Flatten(n.Children, result);
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        _loading = true;
        var allSubnets = await SubnetSvc.ForSectionWithVlanAsync(SectionId);
        var tree       = BuildTree(allSubnets, parentId: 0, depth: 0);
        _flatTree      = [];
        Flatten(tree, _flatTree);
        _vlans   = await VlanSvc.ForSectionAsync(SectionId);
        _loading = false;
    }

    private static string FormatCidr(Subnet s)
    {
        if (string.IsNullOrEmpty(s.SubnetAddress) || string.IsNullOrEmpty(s.Mask)) return "—";
        try
        {
            var v = IpConverter.GuessVersion(s.SubnetAddress);
            return $"{IpConverter.ToPresentation(s.SubnetAddress, v)}/{s.Mask}";
        }
        catch { return $"{s.SubnetAddress}/{s.Mask}"; }
    }
}
