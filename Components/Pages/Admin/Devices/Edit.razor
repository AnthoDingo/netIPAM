@page "/admin/devices/new"
@page "/admin/devices/{Id:int}/edit"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Policy = "Operator")]
@rendermode InteractiveServer

<PageTitle>@(_isNew ? "New device" : "Edit device")</PageTitle>

<AdminPageHeader Title="@(_isNew ? "New device" : "Edit device")" Icon="bi bi-router"
                 BackHref="/admin/devices" BackLabel="Devices" />

<div class="phpipam-card" style="max-width: 760px;">
    <div class="phpipam-card-body">
        @if (_device is not null)
        {
            <EditForm Model="_form" OnValidSubmit="Save" FormName="devEdit">
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Hostname *</label>
                        <InputText class="form-control" @bind-Value="_device.Hostname" />
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label">IP address (presentation)</label>
                        <input type="text" class="form-control" @bind="_form.IpPresentation" placeholder="192.168.1.1" />
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Type</label>
                        <InputSelect class="form-select" @bind-Value="_device.Type">
                            <option value="0">(none)</option>
                            @if (_types is not null) { @foreach (DeviceType t in _types) { <option value="@t.Tid">@t.Tname</option> } }
                        </InputSelect>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Location</label>
                        <InputSelect class="form-select" @bind-Value="_device.Location">
                            <option value="">(none)</option>
                            @if (_locations is not null) { @foreach (Location l in _locations) { <option value="@l.Id">@l.Name</option> } }
                        </InputSelect>
                    </div>
                </div>
                <div class="mb-3">
                    <label class="form-label">Description</label>
                    <InputText class="form-control" @bind-Value="_device.Description" />
                </div>
                <div class="phpipam-card-header mb-3 small text-muted">SNMP (optional)</div>
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label">SNMP community</label>
                        <InputText class="form-control" @bind-Value="_device.SnmpCommunity" />
                    </div>
                    <div class="col-md-3 mb-3">
                        <label class="form-label">Version</label>
                        <InputSelect class="form-select" @bind-Value="_device.SnmpVersion">
                            <option value="0">(none)</option>
                            <option value="1">v1</option>
                            <option value="2">v2c</option>
                            <option value="3">v3</option>
                        </InputSelect>
                    </div>
                    <div class="col-md-3 mb-3">
                        <label class="form-label">Port</label>
                        <InputNumber class="form-control" @bind-Value="_device.SnmpPort" />
                    </div>
                </div>
                @if (!string.IsNullOrEmpty(_error)) { <div class="alert alert-danger py-2">@_error</div> }
                <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg"></i> Save</button>
                <a class="btn btn-link" href="/admin/devices">Cancel</a>
            </EditForm>
        }
    </div>
</div>
