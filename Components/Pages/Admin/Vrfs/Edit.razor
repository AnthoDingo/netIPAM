@page "/admin/vrfs/new"
@page "/admin/vrfs/{Id:int}/edit"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Policy = "Operator")]

<PageTitle>@(_isNew ? "New VRF" : "Edit VRF")</PageTitle>

<AdminPageHeader Title="@(_isNew ? "New VRF" : "Edit VRF")" Icon="bi bi-share"
                 BackHref="/admin/vrfs" BackLabel="VRFs" />

<div class="phpipam-card" style="max-width: 720px;">
    <div class="phpipam-card-body">
        @if (_vrf is not null)
        {
            <EditForm Model="_vrf" OnValidSubmit="Save" FormName="vrfEdit">
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Name *</label>
                        <InputText class="form-control" @bind-Value="_vrf.Name" />
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label">RD (Route Distinguisher)</label>
                        <InputText class="form-control" @bind-Value="_vrf.Rd" placeholder="65000:1" />
                    </div>
                </div>
                <div class="mb-3">
                    <label class="form-label">Description</label>
                    <InputTextArea class="form-control" rows="3" @bind-Value="_vrf.Description" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Sections (comma-separated IDs)</label>
                    <InputText class="form-control" @bind-Value="_vrf.Sections" />
                    <small class="text-muted">Leave empty to apply to all.</small>
                </div>
                <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg"></i> Save</button>
                <a class="btn btn-link" href="/admin/vrfs">Cancel</a>
            </EditForm>
        }
    </div>
</div>
