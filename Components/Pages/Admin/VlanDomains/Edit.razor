@page "/admin/l2domains/new"
@page "/admin/l2domains/{Id:int}/edit"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Policy = "Operator")]


<PageTitle>@(_isNew ? "New L2 domain" : "Edit L2 domain")</PageTitle>

<AdminPageHeader Title="@(_isNew ? "New L2 domain" : "Edit L2 domain")" Icon="bi bi-layers"
                 BackHref="/admin/l2domains" BackLabel="L2 domains" />

<div class="phpipam-card" style="max-width: 640px;">
    <div class="phpipam-card-body">
        @if (_domain is not null)
        {
            <EditForm Model="_domain" OnValidSubmit="Save" FormName="domEdit">
                <div class="mb-3">
                    <label class="form-label">Name *</label>
                    <InputText class="form-control" @bind-Value="_domain.Name" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Description</label>
                    <InputTextArea class="form-control" rows="3" @bind-Value="_domain.Description" />
                </div>
                <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg"></i> Save</button>
                <a class="btn btn-link" href="/admin/l2domains">Cancel</a>
            </EditForm>
        }
    </div>
</div>
