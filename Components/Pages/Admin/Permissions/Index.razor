@page "/admin/permissions"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Policy = "Admin")]
@rendermode InteractiveServer
@inject PermissionService PermSvc
@inject UserService Users
@inject UserGroupService Groups
@inject VlanService Vlans
@inject VlanDomainService L2Domains
@inject VrfService Vrfs
@inject DeviceService Devices

<PageTitle>Permissions — admin</PageTitle>

<AdminPageHeader Title="Permissions" Icon="bi bi-shield-check" />

<div class="row g-3">

    @* ── Colonne gauche : sélection du sujet ────────────────────────── *@
    <div class="col-lg-3">
        <div class="phpipam-card">
            <div class="phpipam-card-header">Groupes</div>
            <div style="max-height:220px;overflow-y:auto">
                @foreach (var g in _groups)
                {
                    var counts = _subjectCounts.GetValueOrDefault((SubjectTypes.Group, g.GId));
                    <div class="phpipam-subject-row @(IsSelected(SubjectTypes.Group, g.GId) ? "active" : "")"
                         @onclick="() => SelectSubject(SubjectTypes.Group, g.GId, g.GName ?? $"Groupe {g.GId}")">
                        <i class="bi bi-people-fill me-2"></i>
                        <span class="flex-grow-1">@g.GName</span>
                        @if (counts is not null)
                        {
                            <span class="badge bg-primary rounded-pill ms-1">@counts.Values.Sum()</span>
                        }
                    </div>
                }
                @if (_groups.Count == 0)
                {
                    <div class="p-3 text-muted small">Aucun groupe.</div>
                }
            </div>
        </div>

        <div class="phpipam-card mt-3">
            <div class="phpipam-card-header">Utilisateurs</div>
            <div style="max-height:260px;overflow-y:auto">
                @foreach (var u in _users)
                {
                    var counts = _subjectCounts.GetValueOrDefault((SubjectTypes.User, u.Id));
                    <div class="phpipam-subject-row @(IsSelected(SubjectTypes.User, u.Id) ? "active" : "")"
                         @onclick="() => SelectSubject(SubjectTypes.User, u.Id, u.Username)">
                        <i class="bi bi-person me-2"></i>
                        <span class="flex-grow-1">@u.Username</span>
                        @if (counts is not null)
                        {
                            <span class="badge bg-primary rounded-pill ms-1">@counts.Values.Sum()</span>
                        }
                    </div>
                }
            </div>
        </div>
    </div>

    @* ── Colonne droite : éditeur de permissions ─────────────────────── *@
    <div class="col-lg-9">
        @if (_selectedSubjectName is null)
        {
            <div class="phpipam-card h-100">
                <div class="phpipam-card-body text-center text-muted py-5">
                    <i class="bi bi-arrow-left-circle d-block mb-2" style="font-size:2rem"></i>
                    Sélectionnez un groupe ou un utilisateur pour gérer ses permissions.
                </div>
            </div>
        }
        else
        {
            <div class="phpipam-card">
                <div class="phpipam-card-header d-flex align-items-center justify-content-between">
                    <span>
                        <i class="bi @(_selectedSubjectType == SubjectTypes.Group ? "bi-people-fill" : "bi-person") me-2"></i>
                        @_selectedSubjectName
                        <span class="badge bg-secondary ms-2">
                            @(_selectedSubjectType == SubjectTypes.Group ? "groupe" : "utilisateur")
                        </span>
                    </span>
                    @if (_saved)
                    {
                        <span class="text-success small"><i class="bi bi-check-circle me-1"></i>Enregistré</span>
                    }
                </div>
                <div class="phpipam-card-body">

                    @* Tabs des types de ressources *@
                    <ul class="nav nav-tabs mb-3">
                        @foreach (var tab in _tabs)
                        {
                            <li class="nav-item">
                                <button class="nav-link @(_activeTab == tab.Key ? "active" : "")"
                                        @onclick="() => _activeTab = tab.Key">
                                    <i class="@tab.Icon me-1"></i>@tab.Label
                                    @if (_draftCounts.TryGetValue(tab.Key, out var c) && c > 0)
                                    {
                                        <span class="badge bg-primary ms-1">@c</span>
                                    }
                                </button>
                            </li>
                        }
                    </ul>

                    @* Table de permissions pour l'onglet actif *@
                    @if (_loading)
                    {
                        <p class="text-muted">Chargement…</p>
                    }
                    else
                    {
                        var rows = GetCurrentRows();
                        @if (rows.Count == 0)
                        {
                            <p class="text-muted small">Aucune ressource de ce type.</p>
                        }
                        else
                        {
                            <table class="phpipam-table">
                                <thead>
                                    <tr>
                                        <th>Ressource</th>
                                        <th>Détails</th>
                                        <th style="width:160px">Accès</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var row in rows)
                                    {
                                        var key  = (_activeTab, row.EntityId);
                                        var level = _draft.TryGetValue(key, out var l) ? l : 0;
                                        <tr>
                                            <td><strong>@row.Name</strong></td>
                                            <td class="text-muted small">@row.Detail</td>
                                            <td>
                                                <select class="form-select form-select-sm"
                                                        value="@level"
                                                        @onchange="e => SetDraft(row.EntityId, int.Parse(e.Value!.ToString()!))">
                                                    <option value="0">— Aucun —</option>
                                                    <option value="1">Lecture</option>
                                                    <option value="2">Écriture</option>
                                                    <option value="3">Admin</option>
                                                </select>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        }

                        <div class="mt-3 d-flex gap-2 align-items-center">
                            <button class="btn btn-primary btn-sm" @onclick="SaveCurrentTab">
                                <i class="bi bi-check-lg me-1"></i>Enregistrer les permissions @_tabs.First(t => t.Key == _activeTab).Label
                            </button>
                            <button class="btn btn-outline-secondary btn-sm" @onclick="ClearCurrentTab">
                                <i class="bi bi-x-lg me-1"></i>Tout révoquer
                            </button>
                        </div>
                    }
                </div>
            </div>

            @* Récap des permissions effectives (si utilisateur) *@
            @if (_selectedSubjectType == SubjectTypes.User && _userGroupIds.Count > 0)
            {
                <div class="phpipam-card mt-3">
                    <div class="phpipam-card-header">
                        <i class="bi bi-info-circle me-1"></i>
                        Permissions héritées des groupes
                    </div>
                    <div class="phpipam-card-body small text-muted">
                        Cet utilisateur appartient aux groupes :
                        @foreach (var gId in _userGroupIds)
                        {
                            var g = _groups.FirstOrDefault(x => x.GId == gId);
                            <span class="badge bg-secondary me-1">@(g?.GName ?? $"#{gId}")</span>
                        }
                        <br />Les permissions de ces groupes s'ajoutent aux permissions directes (la valeur la plus haute l'emporte).
                    </div>
                </div>
            }
        }
    </div>
</div>

<style>
    .phpipam-subject-row {
        display: flex; align-items: center; padding: 8px 14px;
        cursor: pointer; border-bottom: 0.5px solid var(--color-border-tertiary);
        font-size: 13px; transition: background .1s;
    }
    .phpipam-subject-row:hover { background: var(--color-background-secondary); }
    .phpipam-subject-row.active { background: #ebf5fb; color: #185fa5; font-weight: 500; }
</style>

@code {
    record TabDef(string Key, string Label, string Icon);
    record ResourceRow(int EntityId, string Name, string Detail);

    private readonly List<TabDef> _tabs =
    [
        new(EntityTypes.Vlan,     "VLANs",      "bi bi-tag"),
        new(EntityTypes.L2Domain, "L2 Domains", "bi bi-layers"),
        new(EntityTypes.Vrf,      "VRFs",        "bi bi-share"),
        new(EntityTypes.Device,   "Devices",     "bi bi-router"),
    ];

    // Données chargées au démarrage
    private List<UserGroup> _groups = [];
    private List<User>      _users  = [];
    private Dictionary<(string, int), Dictionary<string, int>> _subjectCounts = new();

    // Ressources par type
    private List<Vlan>       _vlans   = [];
    private List<VlanDomain> _l2Doms  = [];
    private List<Vrf>        _vrfs    = [];
    private List<Device>     _devs    = [];

    // Sujet sélectionné
    private string? _selectedSubjectType;
    private int     _selectedSubjectId;
    private string? _selectedSubjectName;
    private List<int> _userGroupIds = [];

    // Draft (onglet actif)
    private string _activeTab = EntityTypes.Vlan;
    private Dictionary<(string, int), int> _draft = new();
    private Dictionary<string, int> _draftCounts  = new();
    private bool _loading;
    private bool _saved;

    protected override async Task OnInitializedAsync()
    {
        _groups  = await Groups.ListAsync();
        _users   = await Users.ListAsync();
        _vlans   = await Vlans.ListAsync();
        _l2Doms  = await L2Domains.ListAsync();
        _vrfs    = await Vrfs.ListAsync();
        _devs    = await Devices.ListAsync();

        // Pré-calculer les compteurs par sujet
        foreach (var g in _groups)
        {
            var counts = await PermSvc.GetPermissionCountsAsync(SubjectTypes.Group, g.GId);
            if (counts.Values.Sum() > 0) _subjectCounts[(SubjectTypes.Group, g.GId)] = counts;
        }
        foreach (var u in _users)
        {
            var counts = await PermSvc.GetPermissionCountsAsync(SubjectTypes.User, u.Id);
            if (counts.Values.Sum() > 0) _subjectCounts[(SubjectTypes.User, u.Id)] = counts;
        }
    }

    private bool IsSelected(string type, int id)
        => _selectedSubjectType == type && _selectedSubjectId == id;

    private async Task SelectSubject(string type, int id, string name)
    {
        _selectedSubjectType = type;
        _selectedSubjectId   = id;
        _selectedSubjectName = name;
        _activeTab           = EntityTypes.Vlan;
        _saved               = false;

        if (type == SubjectTypes.User)
        {
            var u = await Users.FindByIdAsync(id);
            _userGroupIds = u is not null ? Users.GetGroupIds(u) : [];
        }
        else _userGroupIds = [];

        await LoadPermissionsForSubject();
    }

    private async Task LoadPermissionsForSubject()
    {
        _loading = true; StateHasChanged();
        _draft.Clear();

        foreach (var tab in _tabs)
        {
            var perms = await PermSvc.GetForSubjectAsync(
                _selectedSubjectType!, _selectedSubjectId, tab.Key);
            foreach (var p in perms)
                _draft[(tab.Key, p.EntityId)] = p.Level;
        }

        RefreshDraftCounts();
        _loading = false;
    }

    private void SetDraft(int entityId, int level)
    {
        var key = (_activeTab, entityId);
        if (level == 0) _draft.Remove(key);
        else _draft[key] = level;
        RefreshDraftCounts();
    }

    private void RefreshDraftCounts()
    {
        _draftCounts = _tabs.ToDictionary(
            t => t.Key,
            t => _draft.Keys.Count(k => k.Item1 == t.Key));
    }

    private async Task SaveCurrentTab()
    {
        var perms = GetCurrentRows()
            .Select(r => (r.EntityId, _draft.TryGetValue((_activeTab, r.EntityId), out var l) ? l : 0));

        await PermSvc.SetBulkAsync(
            _selectedSubjectType!, _selectedSubjectId, _activeTab, perms);

        // Rafraîchir le compteur global
        var counts = await PermSvc.GetPermissionCountsAsync(_selectedSubjectType!, _selectedSubjectId);
        if (counts.Values.Sum() > 0)
            _subjectCounts[(_selectedSubjectType!, _selectedSubjectId)] = counts;
        else
            _subjectCounts.Remove((_selectedSubjectType!, _selectedSubjectId));

        _saved = true;
        StateHasChanged();
        await Task.Delay(2000);
        _saved = false;
    }

    private async Task ClearCurrentTab()
    {
        foreach (var row in GetCurrentRows())
            _draft.Remove((_activeTab, row.EntityId));
        RefreshDraftCounts();
        await SaveCurrentTab();
    }

    private List<ResourceRow> GetCurrentRows() => _activeTab switch
    {
        EntityTypes.Vlan     => _vlans.Select(v => new ResourceRow(v.VlanId, v.Name, $"VLAN {v.Number}")).ToList(),
        EntityTypes.L2Domain => _l2Doms.Select(d => new ResourceRow(d.Id, d.Name ?? $"Domain {d.Id}", d.Description ?? "")).ToList(),
        EntityTypes.Vrf      => _vrfs.Select(v => new ResourceRow(v.VrfId, v.Name, v.Rd ?? "")).ToList(),
        EntityTypes.Device   => _devs.Select(d => new ResourceRow(d.Id, d.Hostname ?? $"Device {d.Id}", d.IpAddr ?? "")).ToList(),
        _                    => []
    };
}
