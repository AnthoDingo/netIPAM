@page "/admin/permissions"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Policy = "Admin")]
@rendermode InteractiveServer

<PageTitle>Permissions — admin</PageTitle>

<AdminPageHeader Title="Permissions" Icon="bi bi-shield-check" />

<div class="row g-3">

    @* ── Colonne gauche : sélection du sujet ────────────────────────── *@
    <div class="col-lg-3">
        <div class="phpipam-card">
            <div class="phpipam-card-header">Groupes</div>
            <div style="max-height:220px;overflow-y:auto">
                @foreach (UserGroup g in _groups)
                {
                    Dictionary<string, int>? counts = _subjectCounts.GetValueOrDefault((SubjectTypes.Group, g.GId));
                    string groupDisplay = g.GName ?? $"Groupe {g.GId}";
                    <div class="phpipam-subject-row @(IsSelected(SubjectTypes.Group, g.GId) ? "active" : "")"
                         @onclick="() => SelectSubject(SubjectTypes.Group, g.GId, groupDisplay)">
                        <i class="bi bi-people-fill me-2"></i>
                        <span class="flex-grow-1">@g.GName</span>
                        @if (counts is not null)
                        {
                            <span class="badge bg-primary rounded-pill ms-1">@counts.Values.Sum()</span>
                        }
                    </div>
                }
                @if (_groups.Count == 0)
                {
                    <div class="p-3 text-muted small">Aucun groupe.</div>
                }
            </div>
        </div>

        <div class="phpipam-card mt-3">
            <div class="phpipam-card-header">Utilisateurs</div>
            <div style="max-height:260px;overflow-y:auto">
                @foreach (User u in _users)
                {
                    Dictionary<string, int>? counts = _subjectCounts.GetValueOrDefault((SubjectTypes.User, u.Id));
                    <div class="phpipam-subject-row @(IsSelected(SubjectTypes.User, u.Id) ? "active" : "")"
                         @onclick="() => SelectSubject(SubjectTypes.User, u.Id, u.Username)">
                        <i class="bi bi-person me-2"></i>
                        <span class="flex-grow-1">@u.Username</span>
                        @if (counts is not null)
                        {
                            <span class="badge bg-primary rounded-pill ms-1">@counts.Values.Sum()</span>
                        }
                    </div>
                }
            </div>
        </div>
    </div>

    @* ── Colonne droite : éditeur de permissions ─────────────────────── *@
    <div class="col-lg-9">
        @if (_selectedSubjectName is null)
        {
            <div class="phpipam-card h-100">
                <div class="phpipam-card-body text-center text-muted py-5">
                    <i class="bi bi-arrow-left-circle d-block mb-2" style="font-size:2rem"></i>
                    Sélectionnez un groupe ou un utilisateur pour gérer ses permissions.
                </div>
            </div>
        }
        else
        {
            <div class="phpipam-card">
                <div class="phpipam-card-header d-flex align-items-center justify-content-between">
                    <span>
                        <i class="bi @(_selectedSubjectType == SubjectTypes.Group ? "bi-people-fill" : "bi-person") me-2"></i>
                        @_selectedSubjectName
                        <span class="badge bg-secondary ms-2">
                            @(_selectedSubjectType == SubjectTypes.Group ? "groupe" : "utilisateur")
                        </span>
                    </span>
                    @if (_saved)
                    {
                        <span class="text-success small"><i class="bi bi-check-circle me-1"></i>Enregistré</span>
                    }
                </div>
                <div class="phpipam-card-body">

                    @* Tabs des types de ressources *@
                    <ul class="nav nav-tabs mb-3">
                        @foreach (TabDef tab in _tabs)
                        {
                            <li class="nav-item">
                                <button class="nav-link @(_activeTab == tab.Key ? "active" : "")"
                                        @onclick="() => _activeTab = tab.Key">
                                    <i class="@tab.Icon me-1"></i>@tab.Label
                                    @if (_draftCounts.TryGetValue(tab.Key, out var c) && c > 0)
                                    {
                                        <span class="badge bg-primary ms-1">@c</span>
                                    }
                                </button>
                            </li>
                        }
                    </ul>

                    @* Table de permissions pour l'onglet actif *@
                    @if (_loading)
                    {
                        <p class="text-muted">Chargement…</p>
                    }
                    else
                    {
                        List<ResourceRow> rows = GetCurrentRows();
                        @if (rows.Count == 0)
                        {
                            <p class="text-muted small">Aucune ressource de ce type.</p>
                        }
                        else
                        {
                            <table class="phpipam-table">
                                <thead>
                                    <tr>
                                        <th>Ressource</th>
                                        <th>Détails</th>
                                        <th style="width:160px">Accès</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (ResourceRow row in rows)
                                    {
                                        (string, int) key  = (_activeTab, row.EntityId);
                                        int level = _draft.TryGetValue(key, out var l) ? l : 0;
                                        <tr>
                                            <td><strong>@row.Name</strong></td>
                                            <td class="text-muted small">@row.Detail</td>
                                            <td>
                                                <select class="form-select form-select-sm"
                                                        value="@level"
                                                        @onchange="e => SetDraft(row.EntityId, int.Parse(e.Value!.ToString()!))">
                                                    <option value="0">— Aucun —</option>
                                                    <option value="1">Lecture</option>
                                                    <option value="2">Écriture</option>
                                                    <option value="3">Admin</option>
                                                </select>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        }

                        <div class="mt-3 d-flex gap-2 align-items-center">
                            <button class="btn btn-primary btn-sm" @onclick="SaveCurrentTab">
                                <i class="bi bi-check-lg me-1"></i>Enregistrer les permissions @_tabs.First(t => t.Key == _activeTab).Label
                            </button>
                            <button class="btn btn-outline-secondary btn-sm" @onclick="ClearCurrentTab">
                                <i class="bi bi-x-lg me-1"></i>Tout révoquer
                            </button>
                        </div>
                    }
                </div>
            </div>

            @* Récap des permissions effectives (si utilisateur) *@
            @if (_selectedSubjectType == SubjectTypes.User && _userGroupIds.Count > 0)
            {
                <div class="phpipam-card mt-3">
                    <div class="phpipam-card-header">
                        <i class="bi bi-info-circle me-1"></i>
                        Permissions héritées des groupes
                    </div>
                    <div class="phpipam-card-body small text-muted">
                        Cet utilisateur appartient aux groupes :
                        @foreach (int gId in _userGroupIds)
                        {
                            UserGroup? g = _groups.FirstOrDefault(x => x.GId == gId);
                            <span class="badge bg-secondary me-1">@(g?.GName ?? $"#{gId}")</span>
                        }
                        <br />Les permissions de ces groupes s'ajoutent aux permissions directes (la valeur la plus haute l'emporte).
                    </div>
                </div>
            }
        }
    </div>
</div>

<style>
    .phpipam-subject-row {
        display: flex; align-items: center; padding: 8px 14px;
        cursor: pointer; border-bottom: 0.5px solid var(--color-border-tertiary);
        font-size: 13px; transition: background .1s;
    }
    .phpipam-subject-row:hover { background: var(--color-background-secondary); }
    .phpipam-subject-row.active { background: #ebf5fb; color: #185fa5; font-weight: 500; }
</style>
