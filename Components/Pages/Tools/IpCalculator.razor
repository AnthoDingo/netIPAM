@page "/tools/ipcalc"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@rendermode InteractiveServer

<PageTitle>IP Calculator</PageTitle>

<h1 class="h3 mb-4"><i class="bi bi-calculator me-2"></i>IP Calculator</h1>

<div class="row">
    <div class="col-lg-5">
        <div class="phpipam-card">
            <div class="phpipam-card-header">Input</div>
            <div class="phpipam-card-body">
                <div class="mb-3">
                    <label class="form-label">CIDR (IPv4 or IPv6)</label>
                    <input type="text" class="form-control" @bind="_input" @bind:event="oninput" placeholder="10.0.0.0/24" />
                </div>
                <button class="btn btn-primary" @onclick="Compute">
                    <i class="bi bi-arrow-right"></i> Compute
                </button>
                @if (!string.IsNullOrEmpty(_error))
                {
                    <div class="alert alert-danger py-2 mt-3 mb-0">@_error</div>
                }
            </div>
        </div>
    </div>

    <div class="col-lg-7">
        @if (_info is not null)
        {
            <div class="phpipam-card">
                <div class="phpipam-card-header">Result — @($"{_info.Network}/{_info.Mask}")</div>
                <div class="phpipam-card-body">
                    <dl class="row mb-0">
                        <dt class="col-sm-5 text-muted">Version</dt>
                        <dd class="col-sm-7">IPv@(_info.Version == IpVersion.V4 ? "4" : "6")</dd>
                        <dt class="col-sm-5 text-muted">Network address</dt>
                        <dd class="col-sm-7"><code>@_info.Network</code></dd>
                        <dt class="col-sm-5 text-muted">Broadcast</dt>
                        <dd class="col-sm-7"><code>@_info.Broadcast</code></dd>
                        <dt class="col-sm-5 text-muted">First usable</dt>
                        <dd class="col-sm-7"><code>@_info.FirstUsable</code></dd>
                        <dt class="col-sm-5 text-muted">Last usable</dt>
                        <dd class="col-sm-7"><code>@_info.LastUsable</code></dd>
                        <dt class="col-sm-5 text-muted">Total addresses</dt>
                        <dd class="col-sm-7">@_info.TotalAddresses</dd>
                        <dt class="col-sm-5 text-muted">Usable hosts</dt>
                        <dd class="col-sm-7">@_info.UsableHosts</dd>
                        <dt class="col-sm-5 text-muted">Prefix length</dt>
                        <dd class="col-sm-7">/@_info.Mask</dd>
                    </dl>
                </div>
            </div>
        }
    </div>
</div>

@code {
    private string _input = string.Empty;
    private string? _error;
    private SubnetCalculator.SubnetInfo? _info;

    private void Compute()
    {
        _error = null;
        _info = null;

        if (string.IsNullOrWhiteSpace(_input) || !_input.Contains('/'))
        {
            _error = "Enter a CIDR like 192.168.1.0/24 or 2001:db8::/64";
            return;
        }
        string[] parts = _input.Trim().Split('/');
        try
        {
            string dec = IpConverter.ToDecimal(parts[0]);
            if (!int.TryParse(parts[1], out var mask)) { _error = "Mask must be an integer."; return; }
            _info = SubnetCalculator.Describe(dec, mask);
        }
        catch (Exception ex) { _error = ex.Message; }
    }
}
