@using Microsoft.AspNetCore.Components.Forms
@using System.Linq.Expressions

<tr class="">
    <td class="title">@Title</td>
    <td>
        <InputText 
            Value="@Value"
            ValueChanged="@ValueChanged"
            ValueExpression="@ValueExpression"
            class="form-control input-sm" 
            name="@Name" />
    </td>
    <td class="info2">
        @Description
    </td>
</tr>
