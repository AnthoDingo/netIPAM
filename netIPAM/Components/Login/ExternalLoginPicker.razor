@if (externalLogins.Length > 0)
{
    <form class="form-horizontal" action="/login/external" method="post" data-enhance="false">
        @* <AntiforgeryToken /> *@
        <input type="hidden" name="ReturnUrl" value="@ReturnUrl" />
        @foreach (var provider in externalLogins)
        {
            <div class="col-xs-12">
                <button type="submit" class="btn btn-sm btn-default" style="width:100%;margin-top:20px;" name="provider" value="@provider.Name" title="Log in using your @provider.DisplayName account">Log in with @provider.DisplayName</button>
            </div>       
        }
    </form>
    
}
