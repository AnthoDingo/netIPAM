@page "/admin/users"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Policy = "Admin")]
@inherits LocalizedComponentBase

<PageTitle>Users — admin</PageTitle>

<AdminPageHeader Title="Users" Icon="bi bi-people">
    <Actions>
        <a class="btn btn-primary btn-sm" href="/admin/users/new">
            <i class="bi bi-plus-lg"></i> New user
        </a>
    </Actions>
</AdminPageHeader>

@if (_users is null)
{
    <p class="text-muted">@T("common.loading")</p>
}
else
{
    <div class="phpipam-card">
        <table class="phpipam-table">
            <thead>
                <tr>
                    <th>@T("common.username")</th>
                    <th>@T("common.realName")</th>
                    <th>@T("common.email")</th>
                    <th>@T("common.role")</th>
                    <th>@T("common.status")</th>
                    <th>@T("common.lastName")</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (User u in _users)
                {
                    <tr>
                        <td><strong>@u.Username</strong></td>
                        <td>@u.RealName</td>
                        <td>@u.Email</td>
                        <td>@(string.IsNullOrEmpty(u.Role) ? "—" : u.Role)</td>
                        <td>
                            @if (string.Equals(u.Disabled, "Yes", StringComparison.OrdinalIgnoreCase))
                            {
                                <span class="badge bg-danger">@T("common.disabled")</span>
                            }
                            else
                            {
                                <span class="badge bg-success">@T("common.active")</span>
                            }
                        </td>
                        <td class="text-muted">@(u.LastLogin?.ToString("yyyy-MM-dd HH:mm") ?? "—")</td>
                        <td class="text-end">
                            <a class="btn btn-sm btn-outline-secondary" href="@($"/admin/users/{u.Id}/edit")" title="Edit">
                                <i class="bi bi-pencil"></i>
                            </a>
                            <a class="btn btn-sm btn-outline-secondary" href="@($"/admin/users/{u.Id}/password")" title="Reset password">
                                <i class="bi bi-key"></i>
                            </a>
                            <button class="btn btn-sm btn-outline-danger" @onclick="() => Delete(u.Id)" title="@T("common.delete")">
                                <i class="bi bi-trash"></i>
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
