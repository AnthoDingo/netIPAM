@page "/admin/users/new"
@page "/admin/users/{Id:int}/edit"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Policy = "Admin")]
@inherits LocalizedComponentBase

<PageTitle>@(_isNew ? "New user" : $"Edit {_user?.Username}")</PageTitle>

<AdminPageHeader Title="@(_isNew ? "New user" : "Edit user")"
                 Icon="bi bi-person"
                 BackHref="/admin/users" BackLabel="Users" />

<div class="phpipam-card" style="max-width: 720px;">
    <div class="phpipam-card-body">
        @if (_user is not null)
        {
            <EditForm Model="_form" OnValidSubmit="Save" FormName="userEdit">
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Username *</label>
                        <InputText class="form-control" @bind-Value="_user.Username" disabled="@(!_isNew)" />
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label">@T("common.realName")</label>
                        <InputText class="form-control" @bind-Value="_user.RealName" />
                    </div>
                </div>
                <div class="mb-3">
                    <label class="form-label">@T("common.email")</label>
                    <InputText class="form-control" @bind-Value="_user.Email" />
                </div>
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label">@T("common.role")</label>
                        <InputSelect class="form-select" @bind-Value="_user.Role">
                            <option value="">(none)</option>
                            <option value="Administrator">@T("users.roleAdmin")</option>
                            <option value="Operator">@T("users.roleOperator")</option>
                            <option value="Guest">@T("users.roleGuest")</option>
                        </InputSelect>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label">@T("common.status")</label>
                        <InputSelect class="form-select" @bind-Value="_user.Disabled">
                            <option value="No">@T("common.active")</option>
                            <option value="Yes">@T("common.disabled")</option>
                        </InputSelect>
                    </div>
                </div>

                @if (_isNew)
                {
                    <div class="mb-3">
                        <label class="form-label">@T("users.initialPassword") *</label>
                        <input type="password" class="form-control" @bind="_form.Password" />
                        <small class="text-muted">@T("users.passwordHint")</small>
                    </div>
                }

                @if (!string.IsNullOrEmpty(_error))
                {
                    <div class="alert alert-danger py-2">@_error</div>
                }

                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-check-lg"></i> Save
                </button>
                <a class="btn btn-link" href="/admin/users">Cancel</a>
            </EditForm>
        }
    </div>
</div>
