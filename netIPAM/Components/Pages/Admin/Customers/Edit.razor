@page "/admin/customers/new"
@page "/admin/customers/{Id:int}/edit"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Policy = "Operator")]

<PageTitle>@(_isNew ? "New customer" : "Edit customer")</PageTitle>

<AdminPageHeader Title="@(_isNew ? "New customer" : "Edit customer")" Icon="bi bi-building"
                 BackHref="/admin/customers" BackLabel="Customers" />

<div class="phpipam-card" style="max-width: 760px;">
    <div class="phpipam-card-body">
        @if (_customer is not null)
        {
            <EditForm Model="_customer" OnValidSubmit="Save" FormName="custEdit">
                <div class="mb-3">
                    <label class="form-label">@T("common.title") *</label>
                    <InputText class="form-control" @bind-Value="_customer.Title" />
                </div>
                <div class="mb-3">
                    <label class="form-label">@T("common.address")</label>
                    <InputText class="form-control" @bind-Value="_customer.Address" />
                </div>
                <div class="row">
                    <div class="col-md-3 mb-3">
                        <label class="form-label">Postcode</label>
                        <InputText class="form-control" @bind-Value="_customer.Postcode" />
                    </div>
                    <div class="col-md-5 mb-3">
                        <label class="form-label">@T("common.city")</label>
                        <InputText class="form-control" @bind-Value="_customer.City" />
                    </div>
                    <div class="col-md-4 mb-3">
                        <label class="form-label">@T("common.state")</label>
                        <InputText class="form-control" @bind-Value="_customer.State" />
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-4 mb-3">
                        <label class="form-label">Contact name</label>
                        <InputText class="form-control" @bind-Value="_customer.ContactPerson" />
                    </div>
                    <div class="col-md-4 mb-3">
                        <label class="form-label">@T("common.phone")</label>
                        <InputText class="form-control" @bind-Value="_customer.ContactPhone" />
                    </div>
                    <div class="col-md-4 mb-3">
                        <label class="form-label">@T("common.email")</label>
                        <InputText class="form-control" @bind-Value="_customer.ContactMail" />
                    </div>
                </div>
                <div class="mb-3">
                    <label class="form-label">@T("common.status")</label>
                    <InputSelect class="form-select" @bind-Value="_customer.Status">
                        <option value="Active">@T("common.active")</option>
                        <option value="Reserved">@T("ipAddresses.reserved")</option>
                        <option value="Inactive">@T("common.inactive")</option>
                    </InputSelect>
                </div>
                <div class="mb-3">
                    <label class="form-label">@T("common.note")</label>
                    <InputTextArea class="form-control" rows="3" @bind-Value="_customer.Note" />
                </div>
                <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg"></i> @T("common.save")</button>
                <a class="btn btn-link" href="/admin/customers">Cancel</a>
            </EditForm>
        }
    </div>
</div>
