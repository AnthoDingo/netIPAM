@page "/admin/vrfs"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Policy = "Operator")]
@inherits LocalizedComponentBase

<PageTitle>VRFs — admin</PageTitle>

<AdminPageHeader Title="VRFs" Icon="bi bi-share">
    <Actions>
        <a class="btn btn-primary btn-sm" href="/admin/vrfs/new"><i class="bi bi-plus-lg"></i> @T("common.new") VRF</a>
    </Actions>
</AdminPageHeader>

@if (_vrfs is null) { <p class="text-muted">@T("common.loading")</p> }
else if (_vrfs.Count == 0)
{
    <div class="phpipam-card"><div class="phpipam-card-body text-center text-muted py-5">@T("vrfs.noVrfs")</div></div>
}
else
{
    <div class="phpipam-card">
        <table class="phpipam-table">
            <thead><tr><th>@T("common.name")</th><th>RD</th><th>@T("common.description")</th><th class="text-end">Actions</th></tr></thead>
            <tbody>
                @foreach (Vrf v in _vrfs)
                {
                    <tr>
                        <td><strong>@v.Name</strong></td>
                        <td><code>@v.Rd</code></td>
                        <td class="text-muted">@v.Description</td>
                        <td class="text-end">
                            <a class="btn btn-sm btn-outline-secondary" href="@($"/admin/vrfs/{v.VrfId}/edit")"><i class="bi bi-pencil"></i></a>
                            <button class="btn btn-sm btn-outline-danger" @onclick="() => Delete(v.VrfId)"><i class="bi bi-trash"></i></button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
