@page "/admin/devices"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Policy = "Operator")]
@rendermode InteractiveServer

<PageTitle>Devices — admin</PageTitle>

<AdminPageHeader Title="Devices" Icon="bi bi-router">
    <Actions>
        <a class="btn btn-primary btn-sm" href="/admin/devices/new"><i class="bi bi-plus-lg"></i> @T("common.new") device</a>
    </Actions>
</AdminPageHeader>

@if (_devices is null) { <p class="text-muted">@T("common.loading")</p> }
else if (_devices.Count == 0)
{
    <div class="phpipam-card"><div class="phpipam-card-body text-center text-muted py-5">No devices yet.</div></div>
}
else
{
    <div class="phpipam-card">
        <table class="phpipam-table">
            <thead><tr><th>Hostname</th><th>IP</th><th>@T("common.type")</th><th>@T("common.description")</th><th class="text-end">Actions</th></tr></thead>
            <tbody>
                @foreach (Device d in _devices)
                {
                    <tr>
                        <td><strong>@d.Hostname</strong></td>
                        <td><code>@FormatIp(d.IpAddr)</code></td>
                        <td>@_typeName(d.Type ?? 0)</td>
                        <td class="text-muted">@d.Description</td>
                        <td class="text-end">
                            <a class="btn btn-sm btn-outline-secondary" href="@($"/admin/devices/{d.Id}/edit")"><i class="bi bi-pencil"></i></a>
                            <button class="btn btn-sm btn-outline-danger" @onclick="() => Delete(d.Id)"><i class="bi bi-trash"></i></button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
