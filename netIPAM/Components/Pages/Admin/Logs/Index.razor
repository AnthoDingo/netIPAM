@page "/admin/logs"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Policy = "Admin")]
@inherits LocalizedComponentBase

<PageTitle>Logs — admin</PageTitle>

<AdminPageHeader Title="Logs" Icon="bi bi-list-ul">
    <Actions>
        <select class="form-select form-select-sm" style="width:auto;display:inline-block" @bind="_severity">
            <option value="">@T("logs.allSeverities")</option>
            <option value="0">0 — Info</option>
            <option value="1">1 — Warning</option>
            <option value="2">2 — Error</option>
        </select>
        <button class="btn btn-sm btn-outline-secondary ms-2" @onclick="Reload">
            <i class="bi bi-arrow-clockwise"></i> Refresh
        </button>
    </Actions>
</AdminPageHeader>

@if (_logs is null) { <p class="text-muted">@T("common.loading")</p> }
else if (_logs.Count == 0)
{
    <div class="phpipam-card"><div class="phpipam-card-body text-center text-muted py-5">
        <i class="bi bi-list-ul d-block mb-2" style="font-size:2rem;"></i>No logs recorded yet.
    </div></div>
}
else
{
    <p class="text-muted small">@T("logs.showingLatest") @_logs.Count of @_total entries.</p>
    <div class="phpipam-card">
        <table class="phpipam-table">
            <thead>
                <tr><th>@T("common.date")</th><th>@T("common.username")</th><th>IP</th><th>@T("common.severity")</th><th>@T("common.command")</th><th>@T("logs.details")</th></tr>
            </thead>
            <tbody>
                @foreach (Log l in _logs)
                {
                    <tr>
                        <td class="text-muted"><small>@l.Date</small></td>
                        <td>@l.Username</td>
                        <td><code>@l.IpAddr</code></td>
                        <td>@SeverityBadge(l.Severity)</td>
                        <td>@l.Command</td>
                        <td><small class="text-muted">@l.Details</small></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
