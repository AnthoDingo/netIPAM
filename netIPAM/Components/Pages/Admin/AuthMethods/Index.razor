@page "/admin/authmethods"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Policy = "Admin")]
@inherits LocalizedComponentBase

<PageTitle>Auth methods — admin</PageTitle>

<AdminPageHeader Title="Authentication methods" Icon="bi bi-shield-lock">
    <Actions>
        <a class="btn btn-primary btn-sm" href="/admin/authmethods/new">
            <i class="bi bi-plus-lg"></i> New method
        </a>
    </Actions>
</AdminPageHeader>


@if (_methods is null) { <p class="text-muted">@T("common.loading")</p> }
else
{
    <div class="phpipam-card">
        <table class="phpipam-table">
            <thead><tr><th>@T("common.type")</th><th>@T("common.description")</th><th>Protected</th><th class="text-end">Actions</th></tr></thead>
            <tbody>
                @foreach (UserAuthMethod m in _methods)
                {
                    <tr>
                        <td>
                            @{
                                var (icon, label) = m.Type switch {
                                    "local"  => ("bi-hdd",          "Local"),
                                    "http"   => ("bi-globe",        "HTTP"),
                                    "LDAP"   => ("bi-diagram-3",    "LDAP"),
                                    "AD"     => ("bi-microsoft",    "Active Directory"),
                                    "Radius" => ("bi-hdd-network",  "RADIUS"),
                                    "SAML2"  => ("bi-key",          "SAML 2.0"),
                                    _        => ("bi-shield-lock",  m.Type),
                                };
                            }
                            <i class="bi @icon me-1 text-muted"></i><code>@label</code>
                        </td>
                        <td class="text-muted">@m.Description</td>
                        <td>@(string.Equals(m.Protected, "Yes", StringComparison.OrdinalIgnoreCase) ? "Yes" : "No")</td>
                        <td class="text-end">
                            <a class="btn btn-sm btn-outline-secondary" href="@($"/admin/authmethods/{m.Id}/edit")"><i class="bi bi-pencil"></i></a>
                            @if (!string.Equals(m.Protected, "Yes", StringComparison.OrdinalIgnoreCase))
                            {
                                <button class="btn btn-sm btn-outline-danger" @onclick="() => Delete(m.Id)"><i class="bi bi-trash"></i></button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
