@page "/admin/groups/new"
@page "/admin/groups/{Id:int}/edit"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Policy = "Admin")]
@rendermode InteractiveServer
@inherits LocalizedComponentBase

<PageTitle>@(_isNew ? "Nouveau groupe" : $"Groupe — {_group?.GName}")</PageTitle>

<AdminPageHeader Title="@(_isNew ? "Nouveau groupe" : "Modifier le groupe")" Icon="bi bi-people-fill"
                 BackHref="/admin/groups" BackLabel="Groupes" />

@if (_group is not null)
{
    <div class="row">
        <div class="col-lg-5">
            <div class="phpipam-card mb-3">
                <div class="phpipam-card-header">Informations</div>
                <div class="phpipam-card-body">
                    <EditForm Model="_group" OnValidSubmit="Save" FormName="grpEdit">
                        <div class="mb-3">
                            <label class="form-label">Nom *</label>
                            <InputText class="form-control" @bind-Value="_group.GName" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">@T("common.description")</label>
                            <InputTextArea class="form-control" rows="3" @bind-Value="_group.GDesc" />
                        </div>
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-check-lg me-1"></i>Enregistrer
                        </button>
                        <a class="btn btn-link" href="/admin/groups">Annuler</a>
                    </EditForm>
                </div>
            </div>
        </div>

        @if (!_isNew)
        {
            <div class="col-lg-7">
                <div class="phpipam-card">
                    <div class="phpipam-card-header d-flex align-items-center justify-content-between">
                        <span>Membres (@_members.Count utilisateurs)</span>
                    </div>
                    @if (_allUsers is null) { <div class="phpipam-card-body text-muted">Chargement…</div> }
                    else
                    {
                        <div class="phpipam-card-body" style="max-height:380px;overflow-y:auto">
                            @foreach (User u in _allUsers)
                            {
                                bool isMember = _members.Any(m => m.Id == u.Id);
                                <div class="d-flex align-items-center justify-content-between py-2
                                            border-bottom" style="border-color:var(--bs-border-color)!important">
                                    <div>
                                        <strong>@u.Username</strong>
                                        @if (!string.IsNullOrEmpty(u.RealName))
                                        {
                                            <span class="text-muted ms-2 small">@u.RealName</span>
                                        }
                                        @if (!string.IsNullOrEmpty(u.Role))
                                        {
                                            <span class="badge bg-secondary ms-2">@u.Role</span>
                                        }
                                    </div>
                                    @if (isMember)
                                    {
                                        <button class="btn btn-sm btn-outline-danger"
                                                @onclick="() => RemoveMember(u.Id)">
                                            <i class="bi bi-dash-circle"></i> Retirer
                                        </button>
                                    }
                                    else
                                    {
                                        <button class="btn btn-sm btn-outline-success"
                                                @onclick="() => AddMember(u.Id)">
                                            <i class="bi bi-plus-circle"></i> Ajouter
                                        </button>
                                    }
                                </div>
                            }
                        </div>
                        @if (!string.IsNullOrEmpty(_memberMsg))
                        {
                            <div class="phpipam-card-body pt-0">
                                <small class="text-success">@_memberMsg</small>
                            </div>
                        }
                    }
                </div>
            </div>
        }
    </div>
}
