@page "/admin/groups"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Policy = "Admin")]
@inherits LocalizedComponentBase

<PageTitle>User groups — admin</PageTitle>

<AdminPageHeader Title="User groups" Icon="bi bi-people-fill">
    <Actions>
        <a class="btn btn-primary btn-sm" href="/admin/groups/new">
            <i class="bi bi-plus-lg"></i> New group
        </a>
    </Actions>
</AdminPageHeader>

@if (_groups is null) { <p class="text-muted">@T("common.loading")</p> }
else if (_groups.Count == 0)
{
    <div class="phpipam-card"><div class="phpipam-card-body text-center text-muted py-5">@T("groups.noGroups")</div></div>
}
else
{
    <div class="phpipam-card">
        <table class="phpipam-table">
            <thead><tr><th>@T("common.name")</th><th>@T("common.description")</th><th class="text-end">Actions</th></tr></thead>
            <tbody>
                @foreach (UserGroup g in _groups)
                {
                    <tr>
                        <td><strong>@g.GName</strong></td>
                        <td class="text-muted">@g.GDesc</td>
                        <td class="text-end">
                            <a class="btn btn-sm btn-outline-secondary" href="@($"/admin/groups/{g.GId}/edit")"><i class="bi bi-pencil"></i></a>
                            <button class="btn btn-sm btn-outline-danger" @onclick="() => Delete(g.GId)"><i class="bi bi-trash"></i></button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
