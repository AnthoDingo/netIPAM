@page "/login"
@layout EmptyLayout
@inherits LocalizedComponentBase

<PageTitle>Login — netIPAM</PageTitle>

<div class="phpipam-login-bg">
    <div class="phpipam-login-card">
        <div class="text-center mb-4">
            <i class="bi bi-diagram-3-fill" style="font-size: 2.4rem; color: #3498db;"></i>
            <h1 class="h4 mt-2 mb-0">netIPAM</h1>
            <small class="text-muted">.NET port of phpIPAM</small>
        </div>

        @* Formulaire HTML natif → endpoint Minimal API (compatible InteractiveServer) *@
        <form method="post" action="/api/auth/login">
            <input type="hidden" name="returnUrl" value="@ReturnUrl" />

            <div class="mb-3">
                <label class="form-label">@T("login.username")</label>
                <input name="username" type="text" class="form-control"
                       autocomplete="username" required />
            </div>

            <div class="mb-3">
                <label class="form-label">@T("login.password")</label>
                <input name="password" type="password" class="form-control"
                       autocomplete="current-password" required />
            </div>

            @if (Error)
            {
                <div class="alert alert-danger py-2">@T("login.invalidCreds")</div>
            }

            <button type="submit" class="btn btn-primary w-100">
                <i class="bi bi-box-arrow-in-right me-1"></i> Sign in
            </button>
        </form>

        <hr class="my-4" />
        <div class="text-center text-muted small">
            Default : Admin / ipamadmin (change after first login)
        </div>
    </div>
</div>

@code {
    [SupplyParameterFromQuery] public string? ReturnUrl { get; set; }
    [SupplyParameterFromQuery] public bool Error { get; set; }
}
