@page "/sections/{SectionId:int}/subnets"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@rendermode InteractiveServer
@using netIPAM.Components.Shared

<PageTitle>@(_section?.Name ?? "Subnets")</PageTitle>

@* ── Onglets sections ── *@
<SectionTabs ActiveSectionId="SectionId" />

@* ── Layout 2 colonnes ── *@
<div class="pi-section-view">

    @* Sidebar *@
    <aside class="pi-sidebar">
        <SectionSidebar SectionId="SectionId" ActiveSubnetId="null" />
    </aside>

    @* Contenu principal *@
    <div class="pi-section-main">

        @if (_section is null)
        {
            <p class="text-muted">Chargement…</p>
        }
        else
        {
            <div class="d-flex align-items-center justify-content-between mb-3">
                <h1 class="h4 mb-0">
                    <i class="bi bi-folder-fill me-2 text-warning"></i>@_section.Name
                </h1>
                <div class="d-flex gap-2">
                    <a class="btn btn-primary btn-sm" href="@($"/sections/{SectionId}/subnets/new")">
                        <i class="bi bi-plus-lg me-1"></i>Add subnet
                    </a>
                    <a class="btn btn-outline-secondary btn-sm" href="/tools/ipcalc">
                        <i class="bi bi-search me-1"></i>Find subnet
                    </a>
                </div>
            </div>

            @if (_subnets is null || _subnets.Count == 0)
            {
                <div class="phpipam-card">
                    <div class="phpipam-card-body text-center text-muted py-5">
                        <i class="bi bi-diagram-3 d-block mb-2" style="font-size: 2rem;"></i>
                        Aucun subnet dans cette section.
                    </div>
                </div>
            }
            else
            {
                <div class="phpipam-card">
                    <table class="phpipam-table">
                        <thead>
                            <tr>
                                <th>Subnet</th>
                                <th>Description</th>
                                <th>VLAN</th>
                                <th>Usage</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (Subnet s in _subnets.Where(x => x.MasterSubnetId == 0))
                            {
                                @RenderSubnetRow(s, 0)
                            }
                        </tbody>
                    </table>
                </div>
            }
        }
    </div>
</div>
