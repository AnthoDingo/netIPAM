@page "/subnets/{SubnetId:int}/addresses/new"
@page "/subnets/{SubnetId:int}/addresses/{Id:int}/edit"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]

<PageTitle>@(_isNew ? "New IP" : "Edit IP")</PageTitle>

<h1 class="h3 mb-4"><i class="bi bi-hdd-network me-2"></i>@(_isNew ? "New IP address" : "Edit IP address")</h1>

<div class="phpipam-card" style="max-width: 720px;">
    <div class="phpipam-card-body">
        @if (_ip is not null)
        {
            <EditForm Model="_form" OnValidSubmit="Save">
                <div class="mb-3">
                    <label class="form-label">@T("ipAddresses.address") *</label>
                    <input type="text" class="form-control" @bind="_form.Address" placeholder="192.168.1.10" />
                </div>
                <div class="row">
                    <div class="col-md-8 mb-3">
                        <label class="form-label">@T("ipAddresses.hostname")</label>
                        <InputText class="form-control" @bind-Value="_ip.Hostname" />
                    </div>
                    <div class="col-md-4 mb-3">
                        <label class="form-label">State</label>
                        <InputSelect class="form-select" @bind-Value="_ip.State">
                            <option value="0">@T("ipAddresses.offline")</option>
                            <option value="1">Active</option>
                            <option value="2">Used</option>
                            <option value="3">Reserved</option>
                            <option value="4">@T("ipAddresses.dhcp")</option>
                        </InputSelect>
                    </div>
                </div>
                <div class="mb-3">
                    <label class="form-label">Description</label>
                    <InputText class="form-control" @bind-Value="_ip.Description" />
                </div>
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label">MAC</label>
                        <InputText class="form-control" @bind-Value="_ip.Mac" placeholder="aa:bb:cc:dd:ee:ff" />
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label">@T("ipAddresses.owner")</label>
                        <InputText class="form-control" @bind-Value="_ip.Owner" />
                    </div>
                </div>
                <div class="form-check mb-3">
                    <InputCheckbox class="form-check-input" id="gw" @bind-Value="_ip.IsGateway" />
                    <label class="form-check-label" for="gw">@T("ipAddresses.gateway")</label>
                </div>
                <div class="mb-3">
                    <label class="form-label">Note</label>
                    <InputTextArea class="form-control" rows="2" @bind-Value="_ip.Note" />
                </div>

                @if (!string.IsNullOrEmpty(_error))
                {
                    <div class="alert alert-danger py-2">@_error</div>
                }

                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-check-lg"></i> Save
                </button>
                <a class="btn btn-link" href="@($"/subnets/{SubnetId}")">Cancel</a>
            </EditForm>
        }
    </div>
</div>
