@page "/sections/{SectionId:int}/subnets/new"
@page "/subnets/{Id:int}/edit"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]

<PageTitle>@(_isNew ? "New subnet" : "Edit subnet")</PageTitle>

<h1 class="h3 mb-4"><i class="bi bi-diagram-3 me-2"></i>@(_isNew ? "New subnet" : "Edit subnet")</h1>

<div class="phpipam-card" style="max-width: 720px;">
    <div class="phpipam-card-body">
        @if (_subnet is not null)
        {
            <EditForm Model="_form" OnValidSubmit="Save">
                <div class="row">
                    <div class="col-md-9 mb-3">
                        <label class="form-label">Subnet (CIDR notation, e.g. 192.168.1.0/24) *</label>
                        <input type="text" class="form-control" @bind="_form.Cidr" placeholder="192.168.1.0/24" />
                    </div>
                </div>
                <div class="mb-3">
                    <label class="form-label">Description</label>
                    <InputText class="form-control" @bind-Value="_subnet.Description" />
                </div>
                <div class="form-check mb-3">
                    <InputCheckbox class="form-check-input" id="folder" @bind-Value="_subnet.IsFolder" />
                    <label class="form-check-label" for="folder">@T("subnets.isFolder")</label>
                </div>
                <div class="form-check mb-3">
                    <InputCheckbox class="form-check-input" id="showName" @bind-Value="_subnet.ShowName" />
                    <label class="form-check-label" for="showName">@T("subnets.showName")</label>
                </div>

                @if (!string.IsNullOrEmpty(_error))
                {
                    <div class="alert alert-danger py-2">@_error</div>
                }

                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-check-lg"></i> Save
                </button>
                <a class="btn btn-link" href="@CancelHref">Cancel</a>
            </EditForm>
        }
    </div>
</div>
