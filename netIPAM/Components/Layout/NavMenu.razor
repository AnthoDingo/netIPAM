@code {
	private string? currentUrl;
	private List<Tool> tools = new();

	protected override void OnInitialized()
	{
		currentUrl = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
		NavigationManager.LocationChanged += OnLocationChanged;
	}

	protected override async Task OnInitializedAsync()
	{
		tools.Add(new Tool
		{
			Name = "Customers",
			Icon = "fa-users",
			Tooltip = "Customers",
			Link = "/tools/customers/"
		});

		tools.Add(new Tool
		{
			Name = "VLAN",
			Icon = "fa-cloud",
			Tooltip = "Show VLANs and belonging subnets",
			Link = "/tools/vlan/"
		});

		tools.Add(new Tool
		{
			Name = "VRF",
			Icon = "fa-cloud",
			Tooltip = "Show VRFs and belonging networks",
			Link = "/tools/vrf/"
		});

		tools.Add(new Tool
		{
			Name = "NAT",
			Icon = "fa-exchange",
			Tooltip = "Nat translations",
			Link = "/tools/nat/"
		});

		tools.Add(new Tool
		{
			Name = "Locations",
			Icon = "fa-map",
			Tooltip = "Show locations",
			Link = "/tools/locations/"
		});

		tools.Add(new Tool
		{
			Name = "Devices",
			Icon = "fa-desktop",
			Tooltip = "Show all configured devices",
			Link = "/tools/devices/"
		});

		tools.Add(new Tool
		{
			Name = "Racks",
			Icon = "fa-bars",
			Tooltip = "Show racks",
			Link = "/tools/racks/"
		});

		tools.Add(new Tool
		{
			Name = "Circuits",
			Icon = "fa-random",
			Tooltip = "Show circuits",
			Link = "/tools/circuits/"
		});

		tools.Add(new Tool
		{
			Name = "Routing",
			Icon = "fa-exchange",
			Tooltip = "Show routing",
			Link = "/tools/routing/"
		});

		tools.Add(new Tool
		{
			Name = "PSTN",
			Icon = "fa-phone",
			Tooltip = "PSTN prefixes",
			Link = "/tools/pstn-prefixes/"
		});

		tools.Add(new Tool
		{
			Name = "Vaults",
			Icon = "fa-key",
			Tooltip = "Vaults",
			Link = "/tools/vaults/"
		});

		tools.Add(new Tool
		{
			Name = "Search",
			Icon = "fa-search",
			Tooltip = "Search database Addresses, subnets and VLANs",
			Link = "/tools/search/"
		});
	}

	private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
	{
		currentUrl = NavigationManager.ToBaseRelativePath(e.Location);
		StateHasChanged();
	}

	public void Dispose()
	{
		NavigationManager.LocationChanged -= OnLocationChanged;
	}

	private sealed class Tool
	{

		public string Name { get; set; }
		public string Icon { get; set; }
		public string Tooltip { get; set; }
		public string Link { get; set; }
	}
}

