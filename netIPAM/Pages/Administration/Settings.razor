@page "/administration/settings/"

@using Microsoft.AspNetCore.Authorization
@using netIPAM.Components
@using netIPAM.Components.Administration

@* @attribute [Authorize] *@

<PageTitle>netIPAM : Settings</PageTitle>

<HeadContent>
    <link rel="stylesheet" type="text/css" href="@Assets["css/bootstrap/bootstrap-switch.min.css"]">
    <link rel="stylesheet" type="text/css" href="@Assets["css/bootstrap-table/bootstrap-table.min.css"]">
    <link rel="stylesheet" type="text/css" href="@Assets["css/slider.css"]">
    <script src="@Assets["js/magic.js"]"></script>
    <script src="@Assets["js/bootstrap-switch/bootstrap-switch.min.js"]"></script>
    <script src="@Assets["js/bootstrap-table/bootstrap-table.min.js"]"></script>
    <script src="@Assets["js/bootstrap-table/bootstrap-table-cookie.js"]"></script>
    
    <link rel="stylesheet" type="text/css" href="@Assets["css/leaflet.css"]">
    <script src="@Assets["js/leaflet.js"]"></script>
    <link rel="stylesheet" type="text/css" href="@Assets["css/leaflet.fullscreen.css"]">
    <script src="@Assets["js/leaflet.fullscreen.min.js"]"></script>
    <script src="@Assets["js/jquery-ui.min.js"]"></script>
</HeadContent>

<HeaderBar>/ Administration / Settings</HeaderBar>

<!-- menu -->
<NavMenu />

<ContentOverlay>
    <AdminMenu />

    <td id="subnetsContent">
        <div class="row menu-administration" id="content">
            <h4>netIPAM Server settings</h4>
            <hr />
            <EditForm EditContext="editContext" name="settings" id="settings">
                <table id="settings" class="table table-hover table-condensed table-top">
                    <tbody>

                        <!-- #region Site settings -->
                        <!-- Site settings -->
                        <tr class="settings-title">
                            <th colspan="3"><h4>Site settings</h4></th>
                        </tr>

                        <!-- site title-->
                        <AdminInputText Title="Site title"
                                        Name="siteTitle"
                                        Description="Set site title"
                                        @bind-Value="Input.SiteTitle" />

                        <!-- site domain -->
                        <AdminInputText Title="Site domain"
                                        Name="siteDomain"
                                        Description="Set domain for sending mail notifications"
                                        @bind-Value="Input.SiteDomain" />

                        <!-- site URL -->
                        <AdminInputText Title="Site URL"
                                        Name="siteURL"
                                        Description="Set site URL"
                                        @bind-Value="Input.SiteUrl" />

                        <!-- Login header text -->
                        <AdminInputText Title="Login text"
                                        Name="siteLoginText"
                                        Description="Show text above 'username' field on login page (default empty)"
                                        @bind-Value="Input.LoginText" />

                        <!-- Default language -->
                        <!-- Default theme -->
                        <!-- Policy propagation -->
                        <AdminSwitch @rendermode="new InteractiveServerRenderMode(prerender: false)"
                                     Title="Default permission propagation"
                                     Name="permissionPropagate"
                                     Description="Set subnet / section permission propagate button to on by default"
                                     @bind-Value="Input.PermissionPropagation" />
                        
                        <!-- Max session duration -->
                        <!-- Max VLAN number -->
                        <AdminInputNumber Title="Highest VLAN number"
                                          Name="vlanMax"
                                          Description="Set highest VLAN number (default 4096)"
                                          Min="1"
                                          Max="4096"
                                          @bind-Value="Input.MaxVLAN" />
                        
                        <!-- Maintenance mode -->
                        <AdminSwitch @rendermode="new InteractiveServerRenderMode(prerender: false)"
                                     Title="Maintenance mode"
                                     Name="maintaneanceMode"
                                     Description="Put netIPAM to maintenance mode"
                                     @bind-Value="Input.MaintenanceMode" />

                        <!-- #endregion -->
                        <!-- #region Admin settings -->
                        <!-- Admin settings -->
                        <tr class="settings-title">
                            <th colspan="3"><h4>Admin settings</h4></th>
                        </tr>

                        <!-- Admin name -->
                        <AdminInputText Title="Admin name"
                                        Name="siteAdminName"
                                        Description="Set administrator e-mail"
                                        @bind-Value="Input.AdminName" />

                        <!-- Admin mail-->
                        <AdminInputText Title="Admin mail"
                                        Name="siteAdminMail"
                                        Description="Set administrator e-mail"
                                        @bind-Value="Input.AdminEmail" />
                        <!-- #endregion -->
                        <!-- #region Features -->
                        <!-- features -->
                        <tr class="settings-title">
                            <th colspan="3"><h4>Feature settings</h4></th>
                        </tr>

                        <!-- API -->
                        <AdminSwitch @rendermode="new InteractiveServerRenderMode(prerender: false)"
                                     Title="API"
                                     Name="api"
                                     Description="Enable or disable API server module"
                                     @bind-Value="Input.API" />

                        <!-- IP requests -->
                        <AdminSwitch @rendermode="new InteractiveServerRenderMode(prerender: false)"
                                     Title="IP request module"
                                     Name="enableIPrequests"
                                     Description="Enable or disable IP request module server module"
                                     @bind-Value="Input.IPRequestModule" />

                        <!-- VRF -->
                        <AdminSwitch @rendermode="new InteractiveServerRenderMode(prerender: false)"
                                     Title="Enable VRF support"
                                     Name="enableVRF"
                                     Description="Enable or disable VRF module"
                                     @bind-Value="Input.VRFSupport" />

                        <!-- nat -->
                        <AdminSwitch @rendermode="new InteractiveServerRenderMode(prerender: false)"
                                     Title="Enable NAT"
                                     Name="enableNAT"
                                     Description="Enable or disable NAT module"
                                     @bind-Value="Input.NAT" />

                        <!-- powerdns -->
                        <AdminSwitch @rendermode="new InteractiveServerRenderMode(prerender: false)"
                                     Title="Enable PowerDNS"
                                     Name="enablePowerDNS"
                                     Description="Enable or disable PowerDNS module"
                                     @bind-Value="Input.PowerDNS" />

                        <!-- dHCP -->
                        <AdminSwitch @rendermode="new InteractiveServerRenderMode(prerender: false)"
                                     Title="Enable DHCP"
                                     Name="enableDHCP"
                                     Description="Enable or disable DHCP module (not ready yet)"
                                     @bind-Value="Input.DHCP" />

                        <!-- firewall zone management -->
                        <AdminSwitch @rendermode="new InteractiveServerRenderMode(prerender: false)"
                                     Title="Enable Firewall Zones"
                                     Name="enableFirewallZones"
                                     Description="Enable or disable firewall zone management module"
                                     @bind-Value="Input.FirewallZones" />

                        <!-- DNS resolving -->
                        <AdminSwitch @rendermode="new InteractiveServerRenderMode(prerender: false)"
                                     Title="Resolve DNS names"
                                     Name="enableDNSresolving"
                                     Description="Check reverse dns lookups for IP addresses that do not have hostname in database. (Activating this feature can significantly increase ip address pages loading time!)"
                                     @bind-Value="Input.ResolveDNS" />

                        <!-- Share -->
                        <AdminSwitch @rendermode="new InteractiveServerRenderMode(prerender: false)"
                                     Title="Temporary shares"
                                     Name="tempShare"
                                     Description="Allow temporary subnet sharing"
                                     @bind-Value="Input.TemporaryShares" />

                        <!-- changelog -->
                        <AdminSwitch @rendermode="new InteractiveServerRenderMode(prerender: false)"
                                     Title="Changelog"
                                     Name="enableChangelog"
                                     Description="Enable changelog module"
                                     @bind-Value="Input.Changelog" />

                        <!-- Multicast -->
                        <AdminSwitch @rendermode="new InteractiveServerRenderMode(prerender: false)"
                                     Title="Multicast module"
                                     Name="enableMulticast"
                                     Description="Enable or disable multicast module"
                                     @bind-Value="Input.MulticastModule" />

                        <!-- treshold -->
                        <AdminSwitch @rendermode="new InteractiveServerRenderMode(prerender: false)"
                                     Title="Threshold module"
                                     Name="enableThreshold"
                                     Description="Enable or disable threshold module"
                                     @bind-Value="Input.ThresholdModule" />

                        <!-- Rack -->
                        <AdminSwitch @rendermode="new InteractiveServerRenderMode(prerender: false)"
                                     Title="Rack module"
                                     Name="enableRACK"
                                     Description="Enable or disable rack drawing module"
                                     @bind-Value="Input.RackModule" />

                        <!-- Circuits -->
                        <AdminSwitch @rendermode="new InteractiveServerRenderMode(prerender: false)"
                                     Title="Circuits module"
                                     Name="enableCircuits"
                                     Description="Enable or disable Circuits module"
                                     @bind-Value="Input.CircuitsModule" />

                        <!-- Locations -->
                        <AdminSwitch @rendermode="new InteractiveServerRenderMode(prerender: false)"
                                     Title="Localtions module"
                                     Name="enableLocations"
                                     Description="Enable or disable locations module"
                                     @bind-Value="Input.LocationsModule" />

                        <!-- SNMP -->
                        <AdminSwitch @rendermode="new InteractiveServerRenderMode(prerender: false)"
                                     Title="SNMP module"
                                     Name="enableSNMP"
                                     Description="Enable or disable SNMP module for devices"
                                     @bind-Value="Input.SNMPModule" />

                        <!-- psnt -->
                        <AdminSwitch @rendermode="new InteractiveServerRenderMode(prerender: false)"
                                     Title="PSNT module"
                                     Name="enablePSNT"
                                     Description="Enable or disable PSTN module to manage phone numbers"
                                     @bind-Value="Input.PSTNModule" />

                        <!-- customers -->
                        <AdminSwitch @rendermode="new InteractiveServerRenderMode(prerender: false)"
                                     Title="Customers module"
                                     Name="enableCustomers"
                                     Description="Enable or disable customers module for customer management"
                                     @bind-Value="Input.CustomersModule" />

                        <!-- Routing -->
                        <AdminSwitch @rendermode="new InteractiveServerRenderMode(prerender: false)"
                                     Title="Routing module"
                                     Name="enableRouting"
                                     Description="Enable or disable Routing module for routing management"
                                     @bind-Value="Input.RoutingModule" />

                        <!-- Link fields -->
                        <!-- Log lcoation-->
                        <!-- Update Tags -->
                        <AdminSwitch @rendermode="new InteractiveServerRenderMode(prerender: false)"
                                     Title="Update Tags"
                                     Name="updateTags"
                                     Description="Update address tags when address state change occurs"
                                     @bind-Value="Input.UpdateTags" />

                        <!-- enforceUnique -->
                        <AdminSwitch @rendermode="new InteractiveServerRenderMode(prerender: false)"
                                     Title="Require unique subnets"
                                     Name="enforceUnique"
                                     Description="Require unique subnets across all sections"
                                     @bind-Value="Input.RequireUniqueSubnets" />

                        <!-- vlanDuplicate -->
                        <AdminSwitch @rendermode="new InteractiveServerRenderMode(prerender: false)"
                                     Title="Allow duplicate vlans"
                                     Name="vlanDuplicate"
                                     Description="Allow duplicated vlans inside L2 domain"
                                     @bind-Value="Input.AllowDuplicateVlans" />

                        <!-- decode MAC -->
                        <AdminSwitch @rendermode="new InteractiveServerRenderMode(prerender: false)"
                                     Title="Decode MAC vendor"
                                     Name="decodeMAC"
                                     Description="Decode MAC address vendor for addresses"
                                     @bind-Value="Input.DecodeMACVendor" />

                        <!-- Vaults -->
                        <AdminSwitch @rendermode="new InteractiveServerRenderMode(prerender: false)"
                                     Title="Enable Vaults"
                                     Name="enableVaults"
                                     Description="Enable Vaults for storing encrypted information"
                                     @bind-Value="Input.DecodeMACVendor" />

                        <!-- Passkeys -->
                        <AdminSwitch @rendermode="new InteractiveServerRenderMode(prerender: false)"
                                     Title="Enable Passkeys"
                                     Name="passkeys"
                                     Description="Enable passkeys for passwordless login"
                                     @bind-Value="Input.Passkeys" />

                        <!-- #endregion -->

                    </tbody>
                </table>
            </EditForm>
        </div>
    </td>
</ContentOverlay>