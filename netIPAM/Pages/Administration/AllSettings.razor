@page "/administration/"

@using Microsoft.AspNetCore.Authorization
@using netIPAM.Components
@using netIPAM.Models

@attribute [Authorize]

<PageTitle>netIPAM : Settings</PageTitle>

<HeaderBar>/ Administration</HeaderBar>

<!-- menu -->
<NavMenu />

<ContentOverlay>
	<td id="subnetsContent">
		<div class="row menu-administration" id="content">
			<div class="container">
				<div id="dashboard" class="tools-all">
					<div class="row">
						<div class="col-lg-offset-6 col-lg-6 col-xs-offset-12 col-xs-12" style="padding:5px 20px;">
							@* TODO To fix *@
							<input type="text"
								   class="form-control tools-filter-string"
								   placeholder="Filter string"
								   @bind="Filter"
								   @bind:event="oninput"
								   @bind:after="OnFilterChanged" />
						</div>
					</div>
					@foreach (AdminItem item in FilteredGroups)
					{
						<h4>@item.Title</h4>
						<hr class="hr-h4" />
						@foreach (AdminSubItem widget in item.Items)
						{
							<WidgetDash Title="@widget.Title"
										Description="@widget.Description"
										Icon="@widget.Icon"
										Url="@widget.Url" />
						}
						<div class="clearfix" />
					}
				</div>
			</div>
		</div>
	</td>
</ContentOverlay>