@using netIPAM.Components.Administration
@using netIPAM.Models

<td id="subnetsLeft">
    <div id="leftMenu" class="menu-administration">
        @foreach (AdminItem item in Items)
        {
            <div class="panel panel-default adminMenu">
                <div class="panel-heading">
                    <h3 class="panel-title">
                        <i class="@item.Icon"></i> @item.Title
                    </h3>
                </div>
                <ul class="list-group">
                    @foreach (AdminSubItem subItem in item.Items)
                    {
                        <AdminSubMenuItem Name="@subItem.Title" Url="@subItem.Url" />
                    }
                </ul>
            </div>
        }
    </div>
</td>